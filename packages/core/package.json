{
  "name": "@usewhisk/core",
  "version": "0.3.0",
  "description": "Framework-agnostic Whisk engine: quote, send, bridge and resume USDC transfers over Circle CCTP V2 on EVM, Solana, Stellar and Starknet.",
  "license": "MIT",
  "author": "SignorDev (https://github.com/Signor1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usewhisk/whisk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/usewhisk/whisk/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/usewhisk/whisk/issues"
  },
  "keywords": [
    "whisk",
    "usdc",
    "circle",
    "cctp",
    "cctp-v2",
    "stablecoin",
    "send",
    "bridge",
    "payments"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./resolvers": {
      "types": "./dist/resolvers.d.ts",
      "import": "./dist/resolvers.js",
      "require": "./dist/resolvers.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:testnet": "tsx scripts/testnet-matrix.ts",
    "test:upfront": "tsx scripts/upfront-testnet.ts",
    "lint": "tsc --noEmit && tsc -p tsconfig.scripts.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.0",
    "@stellar/stellar-sdk": "^14.1.1",
    "@usewhisk/cctp": "workspace:^",
    "bs58": "^6.0.0",
    "starknet": "^10.8.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "viem": "^2.57.5",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "viem": ">=2.57.5 <3"
  }
}
