{
  "name": "@usewhisk/react",
  "version": "0.2.1",
  "description": "Embeddable Whisk widget for React: send and bridge USDC over Circle CCTP V2 across EVM, Solana, Stellar and Starknet.",
  "license": "MIT",
  "author": "SignorDev (https://github.com/Signor1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usewhisk/whisk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/usewhisk/whisk/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/usewhisk/whisk/issues"
  },
  "keywords": [
    "whisk",
    "react",
    "usdc",
    "widget",
    "embed",
    "circle",
    "cctp",
    "cctp-v2",
    "bridge",
    "send",
    "stablecoin",
    "payments"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "viem": ">=2.57.5 <3"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^1.7.7",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/web3.js": "^1.95.0",
    "@starknet-io/get-starknet-core": "^4.0.0",
    "@stellar/stellar-sdk": "^14.1.1",
    "@usewhisk/core": "workspace:^",
    "@wagmi/core": "^2.17.0",
    "@web3icons/react": "^4.1.17",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "starknet": "^10.8.0",
    "wagmi": "^2.13.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "^2.57.5",
    "vitest": "^4.1.11"
  }
}
