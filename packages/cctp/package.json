{
  "name": "@usewhisk/cctp",
  "version": "0.1.2",
  "description": "Circle CCTP V2 protocol layer for Whisk: chain registry, burn and mint builders, fee maths and the Iris client.",
  "license": "MIT",
  "author": "SignorDev (https://github.com/Signor1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usewhisk/whisk.git",
    "directory": "packages/cctp"
  },
  "homepage": "https://github.com/usewhisk/whisk/tree/main/packages/cctp#readme",
  "bugs": {
    "url": "https://github.com/usewhisk/whisk/issues"
  },
  "keywords": [
    "whisk",
    "cctp",
    "cctp-v2",
    "circle",
    "usdc",
    "stablecoin",
    "bridge",
    "cross-chain",
    "iris"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chains": {
      "types": "./dist/chains.d.ts",
      "import": "./dist/chains.js",
      "require": "./dist/chains.cjs"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js",
      "require": "./dist/abi.cjs"
    },
    "./iris": {
      "types": "./dist/iris.d.ts",
      "import": "./dist/iris.js",
      "require": "./dist/iris.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "check:registry": "tsx scripts/check-registry.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.4.0",
    "@solana/web3.js": "^1.95.0",
    "@stellar/stellar-sdk": "^14.1.1",
    "starknet": "^10.8.0",
    "viem": ">=2.57.5 <3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
