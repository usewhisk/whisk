# WalletConnect Cloud project ID, free at https://cloud.walletconnect.com.
# Without it, only injected (MetaMask / Rabby) and Coinbase Wallet connectors
# light up. Set it in `.env.local` for the WalletConnect option to appear.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Circle App Kit kit key for the Swap surface.
# Get one from https://console.circle.com/api-keys/kit-keys.
#
# Server-only. Read by `app/api/kit-key/route.ts` and surfaced to the
# browser only after the route's origin allow-list check passes, so
# the key is never baked into the static JS bundle.
CIRCLE_KIT_KEY=

# Comma-separated hostnames that the `/api/kit-key` route is willing
# to serve the kit key to. Leave empty in local dev (the route fails
# open). Set the playground's Vercel URL (and any custom domain) in
# production so curl from arbitrary origins gets a 403.
KIT_KEY_ALLOWED_HOSTS=
