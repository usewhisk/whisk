# Postgres — Neon in prod, local Docker in dev.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whisk_console

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3020

# GitHub OAuth — create an app at https://github.com/settings/developers
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT signing key for the appId → JWT verification flow.
# Public keys published at /.well-known/jwks.json for SDK-side verify.
WHISK_JWT_PRIVATE_KEY_JWK=
WHISK_JWT_PUBLIC_KEY_JWK=
