{
  "name": "@usewhisk/docs",
  "version": "0.0.7",
  "private": true,
  "description": "Whisk marketing landing + fumadocs documentation. Served at usewhisk.vercel.app (marketing) and usewhisk.vercel.app/docs (docs).",
  "type": "module",
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "predev": "fumadocs-mdx",
