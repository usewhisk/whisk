    "prebuild": "fumadocs-mdx",
    "build": "next build",
    "start": "next start -p 3030",
    "typecheck": "fumadocs-mdx && tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
