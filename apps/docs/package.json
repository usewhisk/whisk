    "@usewhisk/core": "workspace:*",
    "@usewhisk/react": "workspace:*",
    "@web3icons/react": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "fumadocs-core": "^16.0.5",
    "fumadocs-mdx": "^13.0.2",
    "fumadocs-ui": "^16.0.5",
    "lucide-react": "^0.460.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
