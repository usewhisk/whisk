{
  "name": "whisk",
  "private": true,
  "version": "0.0.0",
  "description": "Whisk: accept USDC from any chain. SDK workspace root.",
  "license": "MIT",
  "author": "SignorDev (https://github.com/Signor1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "build:apps": "pnpm -r --filter './examples/*' build",
    "dev": "pnpm -r --filter './packages/*' --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "typecheck:packages": "pnpm -r --filter './packages/*' typecheck",
    "typecheck:examples": "pnpm -r --filter './examples/*' typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules/.cache",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "prepare": "./scripts/hooks/install.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^22.9.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.20.0": "^1.20.0",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "browserslist@<4.28.7": "^4.28.7",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "hono@<4.13.7": "^4.13.7",
      "image-size@<2.0.3": "^2.0.3",
      "ip-address@>=10.0.0 <10.3.1": "^10.3.1",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "protobufjs@>=7.0.0 <7.6.1": "^7.6.1",
      "sharp@<0.35.5": "^0.35.5",
      "shell-quote@<1.11.0": "^1.11.0",
      "socket.io-parser@>=4.0.0 <4.2.7": "^4.2.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "toml@<4.2.0": "^4.2.0",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-3gc7-fjrx-p6mg"
      ]
    }
  }
}
